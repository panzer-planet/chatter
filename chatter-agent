#!/usr/bin/env bash
# chatter-agent: a headless Claude Code worker that wakes whenever another session posts to chatter.
#
# usage: chatter-agent <worktree-dir | worktree-name> [extra claude flags...]
#   e.g. chatter-agent john &        (from inside the repo: resolves .claude/worktrees/john)
#
# Output goes to ~/.chatter/<name>.log. Talk to it through chatter: chatter post "@repo/branch: do X".
# Stop it with: pkill -f "chatter-agent <name>"
set -uo pipefail
dir=${1:?usage: chatter-agent <worktree-dir | worktree-name> [claude flags...]}; shift
if [ ! -d "$dir" ]; then
  name=$dir; dir="$(git rev-parse --show-toplevel 2>/dev/null)/.claude/worktrees/$name"
  if [ ! -d "$dir" ]; then  # create it, branching from HEAD; reuse the branch if it already exists
    git worktree add -q "$dir" -b "worktree-$name" 2>/dev/null || git worktree add -q "$dir" "worktree-$name" \
      || { echo "chatter-agent: could not create worktree $name" >&2; exit 1; }
    echo "chatter-agent: created worktree $dir on branch worktree-$name"
  fi
fi
cd "$dir" || exit 1
sid=$(uuidgen | tr '[:upper:]' '[:lower:]')
log=~/.chatter/$(basename "$dir").log
echo "chatter-agent: $(basename "$dir") logging to $log"
if [ -t 1 ]; then exec > >(tee -a "$log") 2>&1; else exec >>"$log" 2>&1; fi   # terminal: show and log; background: log only

# Headless sessions have nobody to approve tool calls, so chatter itself must be pre-allowed.
# Anything else the worker needs (edits, git, tests) comes from the flags you pass, e.g.
# --permission-mode acceptEdits --allowedTools "Bash(git *)" "Bash(npm *)"
# Defaults to Sonnet; a --model in the extra flags comes later on the command line and wins.
turn() { claude -p --model sonnet --allowedTools "Bash(chatter *)" "$@" </dev/null; echo; }

echo "chatter-agent: session $sid in $dir" >&2
turn --session-id "$sid" "$@" "You are a chatter worker. Your terminal output is visible but nobody types into it: instructions, questions and answers all go through chatter, and you are woken for a turn whenever someone else posts. Post one line introducing yourself: your worktree, the model you are running on, and that you are waiting for tasks. Then stop."

# ponytail: one wake per foreign message, even if the agent already saw it mid-turn via the hook.
# A redundant wake is one short turn ('chatter read --unread' is empty, agent stops). Coalesce if cost matters.
chatter tail --last 0 --json | while IFS= read -r line; do
  [[ $line == *"\"session\":\"${sid:0:8}\""* ]] && continue
  echo "chatter-agent: waking on: ${line:0:120}" >&2
  turn --resume "$sid" "$@" "New chatter activity. Run 'chatter read --unread'. Act on anything addressed to you or that needs your input, reply via chatter, then stop. If nothing needs you, stop without posting. Never post a bare acknowledgement."
done
