#!/usr/bin/env bash
# chatter-agent: a Claude Code session that nobody types into. It talks through chatter and is woken
# for a turn when there is something to react to. What it does on a wake is defined by its role file.
#
# usage: chatter-agent [--interval SECONDS] [--topic NAME] [claude flags...]                         a boss, woken by a timer
#        chatter-agent <worktree-dir | worktree-name> [--topic NAME] [claude flags...]               a dev, woken by posts
#        chatter-agent status                                                                        list running workers
#
#   No name means boss: you start one boss per repo and it spawns the devs. A name makes a dev.
#   e.g. chatter-agent                            from inside a repo: watches the devs, posts as "boss"
#        chatter-agent john                       from inside a repo: uses .claude/worktrees/john, creating it if needed
#        chatter-agent john --topic guide-invite  same, but only sees and wakes on that topic plus untagged messages
#        --role NAME picks a role file from roles/ explicitly.
#
# Output goes to the terminal and to ~/.chatter/logs/<repo>/<name>.log. Stop with Ctrl-C or:
# pkill -f "chatter-agent john"
set -uo pipefail

# chatter-agent status: lists running workers across every repo on the box, no worktree/session/role
# setup needed. Must be checked before $1 is grabbed as a worktree dir/name below.
if [ "${1:-}" = status ]; then
  found=0
  for repo_dir in ~/.chatter/run/*/; do
    [ -d "$repo_dir" ] || continue
    repo=$(basename "$repo_dir")
    for p in "$repo_dir"*.pid; do
      [ -f "$p" ] || continue
      pid=$(cat "$p")
      kill -0 "$pid" 2>/dev/null || { rm -f "$p" "$repo_dir$(basename "$p" .pid).topic"; continue; }
      found=1
      name=$(basename "$p" .pid)
      role=dev; [ "$name" = boss ] && role=boss
      secs=$(( $(date +%s) - $(stat -f%m "$p" 2>/dev/null || stat -c %Y "$p") ))   # BSD stat, then GNU
      if [ "$secs" -ge 3600 ]; then uptime="$((secs / 3600))h$(((secs % 3600) / 60))m"
      else uptime="$((secs / 60))m"; fi
      log=~/.chatter/logs/$repo/$name.log
      spend="0.00"
      [ -f "$log" ] && spend=$(LC_ALL=C awk -F'\$' '/^chatter-agent: session start/{s=0} /■ turn done/{s+=$2} END{printf "%.2f", s+0}' "$log")
      topic=$(cat "$repo_dir$name.topic" 2>/dev/null); topic=${topic:--}
      echo "$repo $name $role $uptime \$$spend $topic"
    done
  done
  [ "$found" = 0 ] && echo "no workers"
  exit 0
fi

roles=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)/roles
role=""; interval=600; dir=""; args=()
[[ $# -gt 0 && $1 != --* ]] && { dir=$1; shift; }
while [[ $# -gt 0 ]]; do
  case $1 in
    --role) role=$2; shift 2 ;;
    --interval) interval=$2; shift 2 ;;
    --topic) export CHATTER_TOPIC=$2; shift 2 ;;   # scopes the worker's posts, reads, hook deliveries and wake-ups to this topic plus untagged
    *) args+=("$1"); shift ;;
  esac
done
[ -n "$role" ] || { [ -n "$dir" ] && role=dev || role=boss; }   # a name makes a dev; nothing makes a boss
[ -f "$roles/$role.md" ] || { echo "chatter-agent: unknown role '$role' (no $roles/$role.md)" >&2; exit 1; }

if [ "$role" = boss ]; then
  name=boss
  export CHATTER_USER=boss                      # the boss has no worktree; it posts under its role name
  args=(--model haiku ${args[@]+"${args[@]}"})  # reading and nudging is Haiku work; a later --model from you still wins
  args+=(--disallowedTools Edit Write MultiEdit NotebookEdit)   # no hands: the thread is its only tool
else
  [ -n "$dir" ] || { echo "usage: chatter-agent <worktree-dir | worktree-name> [claude flags...]   (no name starts a boss)" >&2; exit 1; }
  if [ ! -d "$dir" ]; then
    name=$dir; dir="$(git rev-parse --show-toplevel 2>/dev/null)/.claude/worktrees/$name"
    if [ ! -d "$dir" ]; then  # create it from the latest default branch on origin, else HEAD; reuse the branch if it exists
      base=""
      if git remote get-url origin >/dev/null 2>&1; then
        git fetch -q origin 2>/dev/null
        base=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null) \
          || { git rev-parse -q --verify origin/main >/dev/null 2>&1 && base=origin/main; } \
          || { git rev-parse -q --verify origin/master >/dev/null 2>&1 && base=origin/master; }
      fi
      git worktree add -q "$dir" -b "worktree-$name" ${base:+"$base"} 2>/dev/null || git worktree add -q "$dir" "worktree-$name" \
        || { echo "chatter-agent: could not create worktree $name" >&2; exit 1; }
      echo "chatter-agent: created worktree $dir on branch worktree-$name from ${base:-HEAD}"
    fi
  fi
  cd "$dir" || exit 1
  name=$(basename "$dir")
fi

sid=$( (uuidgen 2>/dev/null || cat /proc/sys/kernel/random/uuid) | tr '[:upper:]' '[:lower:]')   # Ubuntu may lack uuidgen

# One boss per repo is a promise, not a fact, unless run/log paths are namespaced by repo: otherwise a
# second repo's boss collides with the first's pidfile and a same-named dev in another repo steps on its
# log. cwd is already the repo (the worktree cd'd above, or the launching directory for a boss), so this
# matches chatter's own repo_name(). No repo (outside git, or CHATTER_REPO=) buckets under a literal
# '_none' so it can't collide with a real repo named that.
repo=$(chatter whoami 2>/dev/null | sed -n 's/^repo: *//p')
case $repo in '(none'*|'') repo=_none ;; esac
log=~/.chatter/logs/$repo/$name.log; mkdir -p "$(dirname "$log")"

# One process per name per repo. The pid file lets a boss (or you) kill a worker by name; the tree kill
# takes the running claude turn and the tail down with it, so Ctrl-C or kill leaves nothing behind.
run=~/.chatter/run/$repo; mkdir -p "$run"; pidfile=$run/$name.pid
if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
  echo "chatter-agent: $name is already running (pid $(cat "$pidfile"))" >&2; exit 1
fi
echo $$ >"$pidfile"
echo "${CHATTER_TOPIC:-}" >"$run/$name.topic"
killtree() {
  local IFS=$' \t\n'
  [[ $1 =~ ^[0-9]+$ ]] || { echo "chatter-agent: killtree got a bad pid '$1'" >&2; return; }
  local c; for c in $(pgrep -P "$1"); do killtree "$c"; done; [ "$1" != "$$" ] && kill "$1" 2>/dev/null
}
# Take the whole team down, three ways, because one has already failed in the wild:
# the process group when this shell leads it (a terminal or & launch gives it its own), then devs this
# boss spawned by their pid files, then whatever the tree walk still finds.
spawned=""
cleanup() {
  IFS=$' \t\n'   # a kill can land while the loop is inside 'IFS= read', and bash 3.2 runs the trap with that empty IFS,
  trap '' TERM    # which silently breaks every word split below: the pid list, the spawned names. Found in the wild.
  [ "$(ps -o pgid= -p $$ | tr -d ' ')" = "$$" ] && kill -TERM -- -$$ 2>/dev/null
  local n; for n in $spawned; do [ -f "$run/$n.pid" ] && kill "$(cat "$run/$n.pid")" 2>/dev/null; done
  killtree $$; rm -f "$pidfile" ${fifo:+"$fifo"}
}
trap cleanup EXIT
trap 'exit 143' TERM INT HUP
human=$(jq -r '.human // "the user"' ~/.chatter/config.json 2>/dev/null || echo "the user")
rolefile=$(sed -e "s/\$HUMAN/$human/g" -e "s/\$INTERVAL/$((interval / 60)) minutes/g" "$roles/$role.md")

if [ -t 1 ]; then exec > >(tee -a "$log") 2>&1; else exec >>"$log" 2>&1; fi   # terminal: show and log; background: log only
echo "chatter-agent: $name ($role) logging to $log"
echo "chatter-agent: session start $(date -u '+%Y-%m-%dT%H:%M:%SZ')"   # marks where this run's log begins, so status can tell this run's spend from a previous run's

# Render claude's stream-json into a readable trace: the worker's text, one line per tool call and result, a footer per turn.
# A "result" event with is_error true or a non-success subtype means the turn failed even though claude itself
# exited 0, so it gets the same "✗ turn failed" line turn() looks for below.
show() {
  jq --unbuffered -r '
    if .type == "assistant" then .message.content[]?
      | if .type == "text" then .text
        elif .type == "tool_use" then "▸ \(.name) \(.input.command // .input.file_path // (.input | tostring) | .[:200])"
        else empty end
    elif .type == "user" then .message.content[]? | select(.type == "tool_result")
      | "  ↳ \((.content | if type == "array" then map(.text // "") | join("") else tostring end) | gsub("\n"; " ") | .[:200])"
    elif .type == "result" then
      if .is_error == true or (.subtype // "success") != "success" then
        "✗ turn failed (\(if (.subtype // "success") == "success" then "error" else .subtype end)): \((.result // .error // "") | tostring | .[:300])"
      else "■ turn done in \(.duration_ms / 1000 | floor)s, $\(.total_cost_usd * 100 | round / 100)\n"
      end
    else empty end'
}

# turn PROMPT [claude flags...]. Prompt goes first because --allowedTools is variadic and would swallow it.
# Defaults to Sonnet; a --model in the extra flags comes later on the command line and wins.
# Runs in the background and waits: bash defers signal traps while a foreground command runs, so a kill
# during a turn would otherwise sit until the turn finished. wait is a builtin and is interrupted at once.
# PIPESTATUS only survives a pipeline run directly in this shell, not through a $(...) capture, so the
# trace is teed to a temp file to inspect after the fact rather than captured via command substitution.
# A failed turn (non-zero claude exit, an is_error/bad-subtype result from show(), or no output at all --
# claude producing nothing looks identical to an idle worker) gets one clear line in the log plus a
# 'error:' chatter post, since a log line nobody is tailing doesn't help the boss notice.
turn() {
  (
    local trace; trace=$(mktemp)
    ENABLE_CLAUDEAI_MCP_SERVERS=false MCP_DISCOVERY_CACHE=1 claude -p "$1" --model sonnet --allowedTools "Bash(chatter *)" --output-format stream-json --verbose "${@:2}" </dev/null | show | tee "$trace"   # a worker never calls an MCP tool (allowedTools is chatter-only); skip connecting the claude.ai connectors and defer local server discovery
    local rc=("${PIPESTATUS[@]}") claude_rc="" err=""
    claude_rc=${rc[0]}
    if [ "$claude_rc" -ne 0 ]; then err="claude exited $claude_rc"
    elif grep -q '^✗ turn failed' "$trace"; then err=$(grep -m1 '^✗ turn failed' "$trace" | sed 's/^✗ turn failed //')
    elif ! grep -q '^■ turn done' "$trace"; then err="empty stream, no output from claude"
    fi
    rm -f "$trace"
    if [ -n "$err" ]; then
      echo "✗ turn failed: $err"
      CLAUDE_CODE_SESSION_ID=$sid chatter post "error: turn failed: $err" 2>/dev/null
    fi
  ) & wait $!
}

# Same reason for the message loop: the tail runs behind a fifo and the loop uses the read builtin.
open_tail() { fifo=$(mktemp -u); mkfifo "$fifo"; chatter tail --last 0 --json >"$fifo" & tailpid=$!; exec 3<"$fifo"; }

# Start the --unread cursor at "now": the SessionStart hook already shows the last 30 messages, and without
# this the first 'chatter read --unread' would return the entire thread.
CLAUDE_CODE_SESSION_ID=$sid chatter read --unread >/dev/null 2>&1

# One line per running dev: name, minutes since its last post, and what that post was. Handed to the boss on
# every timer tick so an idle check needs no tool calls and a kill decision rests on facts.
roster() {
  local p n last
  for p in "$run"/*.pid; do
    [ -f "$p" ] || continue; n=$(basename "$p" .pid); [ "$n" = boss ] && continue
    kill -0 "$(cat "$p")" 2>/dev/null || { rm -f "$p"; continue; }
    # shellcheck disable=SC1007  # CHATTER_TOPIC= clears the env var on purpose, not a typo for CHATTER_TOPIC=chatter
    last=$(CHATTER_TOPIC= chatter read --from "$n/" --last 1 --json 2>/dev/null | jq -r --arg now "$(date -u '+%Y-%m-%d %H:%M:%S')" \
      '"last post \((( ($now | strptime("%Y-%m-%d %H:%M:%S") | mktime) - (.created_at | strptime("%Y-%m-%d %H:%M:%S") | mktime) ) / 60 | floor)) min ago: \(.kind): \(.body[:100])"')
    echo "- $n: ${last:-no posts yet}"
  done
}

intro="Your role:

$rolefile

Introduce yourself in one status post giving your role, the model you are running on, and that you are ready, e.g. chatter post \"status: dev, Sonnet 5, ready\". chatter adds your name to every post; never type a name into a message body."
if [ "$role" = boss ]; then
  # A boss may start into a thread that already needs it: an idle dev, an unanswered question, a PR with no
  # summary. So its first turn is an introduction followed by a full check, not just a hello.
  intro="$intro

Then do a first check as if a timer had fired. The last 30 messages are in your context; run 'chatter read --kind idle --last 10' and 'chatter read --kind decision --last 10' for the current state, and 'chatter read --last 60' if the picture is unclear. Running devs:
$(roster)

Act on anything one of your triggers applies to, including devs whose task is finished. Then stop."
else
  intro="$intro Then stop."
fi
open_tail   # before the first turn: anything posted during it (a boss's own spawn: lines, a mention) waits in the fifo
turn "$intro" --session-id "$sid" ${args[@]+"${args[@]}"}

if [ "$role" = boss ]; then
  # Timer-driven: silence is the main thing to notice, and a message-driven loop never fires on silence.
  # A message that mentions @boss wakes it early. Bash 3.2's read -t returns 1 on both timeout and EOF,
  # so the tail runs behind a fifo and its liveness tells the two apart.
  # Control messages. The boss's model has no shell for this; it posts "spawn: NAME [flags]" or "kill: NAME"
  # and this loop, a long-lived process, does it. The same lines from the human (no session) are honoured too.
  # Nobody else's are. Spawned devs are children of this process and die with it.
  control() {  # $1 = kind (spawn|kill), $2 = body: NAME [flags]
    local verb=$1 rest=$2 name flags
    name=${rest%% *}; [[ $rest == *" "* ]] && flags=${rest#* } || flags=""
    [[ $name =~ ^[A-Za-z0-9_-]+$ ]] || { say "status: refused '$verb: $rest': bad name"; return; }
    case $verb in
      spawn)
        local p; for p in "$run"/*.pid; do [ -f "$p" ] && ! kill -0 "$(cat "$p")" 2>/dev/null && rm -f "$p" "$run/$(basename "$p" .pid).topic"; done   # prune dead
        if [ "$(find "$run" -maxdepth 1 -name '*.pid' 2>/dev/null | wc -l)" -ge 5 ]; then say "status: refused spawn of dev '$name': 4 devs already running"; return; fi
        # shellcheck disable=SC2086
        env -u CLAUDE_CODE_SESSION_ID CHATTER_USER= "$0" "$name" $flags </dev/null &
        pending="$pending $name "     # wake the boss when this dev's introduction arrives, so it can assign
        spawned="$spawned $name"
        say "status: spawned dev '$name'${flags:+ ($flags)}" ;;
      kill)
        if [ -f "$run/$name.pid" ]; then kill "$(cat "$run/$name.pid")" 2>/dev/null; say "status: killed dev '$name'"
        else say "status: refused kill of dev '$name': not running"; fi ;;
    esac
  }
  say() { CLAUDE_CODE_SESSION_ID=$sid chatter post "$1" 2>/dev/null; echo "chatter-agent: $1" >&2; }
  # CI needs no model. When a PR link is posted, wait for its checks in the background and post the outcome:
  # green as a status: line, red addressed to whoever posted the link, which wakes them to fix it.
  watch_ci() {  # $1 = PR url, $2 = author who posted it
    [ -n "$1" ] || return
    ( out=$(gh pr checks "$1" --watch 2>&1); ci_rc=$?
      [ $ci_rc -gt 128 ] && exit   # gh was killed, this boss is going down: no verdict, so say nothing
      if [ $ci_rc -eq 0 ]; then say "status: CI green on $1"
      elif grep -q 'no checks reported' <<<"$out"; then say "status: no CI configured for $1, skipping"
      else   # --watch output repeats the table on every refresh, the first ones still pending; ask once more for the final one
        failed=$(gh pr checks "$1" 2>/dev/null | awk -F'\t' '$2 != "pass" && $2 != "skipping" {print "  " $1 ": " $2 ($4 ? " " $4 : "")}' | head -8)
        say "@$2: CI is not green on $1. Fix it, push, and post when it is.
${failed:-$(tail -5 <<<"$out")}"
      fi ) &
  }
  pending=" "

  # Wall-clock timer. read -t restarts its countdown on every line, and a busy thread delivers lines
  # constantly, so the deadline is computed from the clock and each read only waits for what is left of it.
  next=$(( $(date +%s) + interval ))
  while true; do
    now=$(date +%s)
    if [ "$now" -ge "$next" ]; then   # checked before every read, so steady traffic cannot starve it
      echo "chatter-agent: timer check" >&2
      turn "Timer check at $(date '+%H:%M'). Your wake interval is $((interval / 60)) minutes. Running devs:
$(roster)

Run 'chatter read --unread' and act according to your role. Post nothing unless one of your triggers applies. Then stop." --resume "$sid" ${args[@]+"${args[@]}"}
      next=$(( $(date +%s) + interval )); continue
    fi
    if IFS= read -r -t "$(( next - now ))" line <&3; then
      body=$(jq -r .body <<<"$line"); kind=$(jq -r .kind <<<"$line")
      if [[ $kind == spawn || $kind == kill ]]; then
        [[ $line == *"\"session\":\"${sid:0:8}\""* || $line == *"\"session\":\"\""* ]] && control "$kind" "$body"
        continue
      fi
      [[ $line == *"\"session\":\"${sid:0:8}\""* ]] && continue
      author=$(jq -r .author <<<"$line"); short=${author%%/*}
      if [[ $pending == *" $short "* ]]; then
        pending=${pending/ $short / }
        echo "chatter-agent: waking on introduction from $author" >&2
        turn "The dev you spawned, $author, has introduced itself at $(date '+%H:%M'). Run 'chatter read --unread', then post its assignment addressed to it: the task, what exists to reuse, what it depends on, and who it must coordinate with. Then stop." --resume "$sid" ${args[@]+"${args[@]}"}
        continue
      fi
      # Wake early on a mention, a stage transition (decision:) or a PR link; everything else waits for the timer.
      if [[ $line == *"@boss"* ]]; then why="Someone mentioned @boss"
      elif [[ $kind == decision ]]; then why="A stage transition was posted: decision: ${body:0:120}"
      elif [[ $kind == error ]]; then why="A worker turn failed: ${body:0:120}"
      elif [[ $body == *"/pull/"* ]]; then why="A pull request link was posted: ${body:0:120}"; watch_ci "$(grep -o 'https://[^ )>]*/pull/[0-9]*' <<<"$body" | head -1)" "$author"
      else continue; fi
      echo "chatter-agent: waking: ${why:0:120}" >&2
      turn "$why (at $(date '+%H:%M')). Run 'chatter read --unread' and act according to your role: if a task just reached review-ready or a PR, post your summary for the human, but retire its devs only once the CI status line for that PR says green or no CI configured, never on the PR link alone; otherwise act only if a trigger applies. Then stop." --resume "$sid" ${args[@]+"${args[@]}"}
      next=$(( $(date +%s) + interval ))   # a wake is a check; push the timer out
    elif kill -0 "$tailpid" 2>/dev/null; then
      continue   # read timed out; the deadline check at the top of the loop fires the wake
    else
      break   # tail ended
    fi
  done
else
  # Token discipline: skip messages the PostToolUse hook already delivered mid-turn (its cursor is in the db),
  # and put the message in the wake prompt so a "nothing for me" wake is one short reply with no tool calls.
  db=${CHATTER_DB:-$HOME/.chatter/chatter.db}; cursor="notify:${sid:0:8}"
  while IFS= read -r line <&3; do
    [[ $line == *"\"session\":\"${sid:0:8}\""* ]] && continue
    case $(jq -r .kind <<<"$line") in status|idle) continue ;; esac   # narration informs but does not wake; the hook shows it on the next real turn
    id=$(jq -r .id <<<"$line")
    seen=$(sqlite3 "$db" "SELECT last_id FROM cursors WHERE name='$cursor'" 2>/dev/null)
    [[ -n $seen && $id -le $seen ]] && continue        # already seen during the previous turn
    msg=$(jq -r '"#\(.id)\(if .reply_to then " (re #\(.reply_to))" else "" end) \(.kind) \(.author): \(.body)"' <<<"$line")
    echo "chatter-agent: waking on: ${msg:0:120}" >&2
    turn "New chatter message at $(date '+%H:%M'):

$msg

If this needs you (it is addressed to you, affects your work, or asks something you can answer), run 'chatter read --unread' for context and act according to your role. If it does not need you, stop immediately without posting or running anything. Exception: if acting on it leaves you with nothing left to do, end with one line 'idle: waiting for <what>' so the team knows." --resume "$sid" ${args[@]+"${args[@]}"}
    sqlite3 "$db" "INSERT OR REPLACE INTO cursors (name, last_id) VALUES ('$cursor', MAX($id, COALESCE((SELECT last_id FROM cursors WHERE name='$cursor'), 0)))" 2>/dev/null
  done
fi
