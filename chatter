#!/usr/bin/env php
<?php
// chatter: a single global chat thread, stored in a local SQLite file.

function usage(int $code = 1): never {
    fwrite($code === 0 ? STDOUT : STDERR, <<<TXT
usage: chatter post [--as NAME] [MESSAGE]     (reads stdin if MESSAGE omitted)
       chatter read [--since ID] [--last N] [--json]

env:   CHATTER_DB   path to database  (default ~/.chatter/chatter.db)
       CHATTER_USER default author    (default \$USER)

TXT);
    exit($code);
}

// PHP defaults to UTC; use $TZ or the system zone (macOS and Linux both symlink /etc/localtime into a zoneinfo dir).
function localtz(): DateTimeZone {
    $tz = getenv('TZ') ?: preg_replace('#.*/zoneinfo/#', '', (string)@readlink('/etc/localtime'));
    try { return new DateTimeZone($tz ?: 'UTC'); } catch (Exception) { return new DateTimeZone('UTC'); }
}

// Default author: --as, then $CHATTER_USER, then <repo>/<branch> if inside a git checkout, then $USER.
function author(): string {
    if ($u = getenv('CHATTER_USER')) return $u;
    $top = trim((string)shell_exec('git rev-parse --show-toplevel 2>/dev/null'));
    $branch = trim((string)shell_exec('git branch --show-current 2>/dev/null'));
    if ($top !== '' && $branch !== '') return basename($top) . '/' . $branch;
    return getenv('USER') ?: 'anon';
}

function db(): SQLite3 {
    $path = getenv('CHATTER_DB') ?: (getenv('HOME') . '/.chatter/chatter.db');
    @mkdir(dirname($path), 0755, true);
    $db = new SQLite3($path);
    $db->busyTimeout(2000);
    $db->exec('PRAGMA journal_mode=WAL');
    $db->exec('CREATE TABLE IF NOT EXISTS messages (
        id         INTEGER PRIMARY KEY,
        author     TEXT NOT NULL,
        body       TEXT NOT NULL,
        created_at TEXT NOT NULL DEFAULT (datetime(\'now\'))
    )');
    return $db;
}

// Parse argv into ['flag' => value, ...] plus positional args.
function args(array $argv, array $valued): array {
    $opts = []; $pos = [];
    for ($i = 0; $i < count($argv); $i++) {
        $a = $argv[$i];
        if (!str_starts_with($a, '--')) { $pos[] = $a; continue; }
        $name = substr($a, 2);
        if (in_array($name, $valued, true)) {
            if (!isset($argv[$i + 1])) usage();
            $opts[$name] = $argv[++$i];
        } else {
            $opts[$name] = true;
        }
    }
    return [$opts, $pos];
}

function post(array $argv): void {
    [$opts, $pos] = args($argv, ['as']);
    $author = $opts['as'] ?? author();
    $body = $pos[0] ?? stream_get_contents(STDIN);
    $body = trim($body);
    if ($body === '') { fwrite(STDERR, "chatter: empty message\n"); exit(2); }

    $st = db()->prepare('INSERT INTO messages (author, body) VALUES (:a, :b)');
    $st->bindValue(':a', $author);
    $st->bindValue(':b', $body);
    $st->execute();
}

function read(array $argv): void {
    [$opts] = args($argv, ['since', 'last']);
    $sql = 'SELECT id, author, body, created_at FROM messages';
    if (isset($opts['since'])) $sql .= ' WHERE id > ' . (int)$opts['since'];
    if (isset($opts['last'])) {
        // newest N, then flip back to chronological order
        $sql = "SELECT * FROM ($sql ORDER BY id DESC LIMIT " . (int)$opts['last'] . ') ORDER BY id';
    } else {
        $sql .= ' ORDER BY id';
    }

    $res = db()->query($sql);
    while ($row = $res->fetchArray(SQLITE3_ASSOC)) {
        echo isset($opts['json'])
            ? json_encode($row, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . "\n"
            : sprintf("#%d  %s  %s: %s\n", $row['id'],
                (new DateTime($row['created_at'], new DateTimeZone('UTC')))->setTimezone(localtz())->format('Y-m-d H:i'),
                $row['author'], $row['body']);
    }
}

match ($argv[1] ?? null) {
    'post' => post(array_slice($argv, 2)),
    'read' => read(array_slice($argv, 2)),
    'help', '-h', '--help' => usage(0),
    default => usage(),
};
