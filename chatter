#!/usr/bin/env php
<?php
// chatter: a single global chat thread, stored in a local SQLite file.

function usage(int $code = 1): never {
    fwrite($code === 0 ? STDOUT : STDERR, <<<TXT
usage: chatter post [--kind KIND] [--as NAME] [--reply-to ID] [--topic NAME] [--] [MESSAGE]   (reads stdin if MESSAGE omitted)
       chatter read [--last N] [--since ID] [--unread] [--kind KIND] [--from NAME] [--grep TEXT] [--topic NAME] [--repo NAME] [--json]
       chatter tail [--last N] [--once] [--kind KIND] [--topic NAME] [--repo NAME] [--json]   (follow live until killed; --once exits after the first new message(s))
       chatter notify                                              (Claude Code PostToolUse hook; see README)
       chatter whoami [--repo]                                     (author, repo and topic a post from here would carry;
                                                                     --repo prints just the repo name, or nothing, for scripts)
       chatter help | -h | --help                                  (works after any subcommand too)

       --kind    every message has one. Give it with --kind, or start the body with "kind: " and it is
                 lifted out of the body. Any lowercase word; by convention: chat (default), status, claim,
                 done, decision, gotcha, question, spawn, kill. Filter with read/tail --kind KIND.
       --reply-to must be the id of an existing message, or post is refused.
       --        ends option parsing; use it so a MESSAGE that itself starts with "--" is not read as a flag.
       --unread  only messages since your last --unread; the cursor is stored per author name and repo.
                 No cursor yet? Capped at the last 30, same as the SessionStart hook, not the whole thread.
       --from    authors starting with NAME        --grep  messages containing TEXT (case-insensitive)
       --topic   only that topic. Without it, CHATTER_TOPIC (if set) selects that topic plus untagged messages.
       --repo    only that repo. Without it, inside a git checkout you see that repo plus untagged messages.
                 Posts made inside a checkout are tagged with its repo automatically; outside git they are untagged.

env:   CHATTER_DB    database path       (default ~/.chatter/chatter.db)
       CHATTER_USER  author for post     (default: Claude sessions <checkout>/<branch>, or "claude" outside git; humans "human" from config, else \$USER)
       CHATTER_TOPIC default topic for post; scopes read/tail/notify to that topic plus untagged
       CHATTER_REPO  override the repo detected from git (set empty to post untagged from inside a checkout)
       NO_COLOR      disable colour on terminals
file:  ~/.chatter/config.json   {"human": "Your Name"}   your display name; workers are told this is you

TXT);
    exit($code);
}

// PHP defaults to UTC; use $TZ or the system zone. macOS and most Linux symlink /etc/localtime into a zoneinfo
// dir; some Linux setups copy the file instead and name the zone in /etc/timezone.
function localtz(): DateTimeZone {
    $tz = getenv('TZ') ?: preg_replace('#.*/zoneinfo/#', '', (string)@readlink('/etc/localtime'))
        ?: trim((string)@file_get_contents('/etc/timezone'));
    try { return new DateTimeZone($tz ?: 'UTC'); } catch (Exception) { return new DateTimeZone('UTC'); }
}

function config(string $key): ?string {
    static $cfg = null;
    $cfg ??= json_decode((string)@file_get_contents(getenv('HOME') . '/.chatter/config.json'), true) ?: [];
    return isset($cfg[$key]) ? (string)$cfg[$key] : null;
}

// Default author: --as, then $CHATTER_USER, then for a Claude session <checkout>/<branch>, otherwise the
// configured human name, then $USER. A plain shell inside a repo is still the human, not a session.
function author(): string {
    if ($u = getenv('CHATTER_USER')) return $u;
    if (getenv('CLAUDE_CODE_SESSION_ID')) {
        $top = trim((string)shell_exec('git rev-parse --show-toplevel 2>/dev/null'));
        $branch = trim((string)shell_exec('git branch --show-current 2>/dev/null'));
        return ($top !== '' && $branch !== '') ? basename($top) . '/' . $branch : 'claude';   // a session is never the human
    }
    return config('human') ?? (getenv('USER') ?: 'anon');
}

function db(): SQLite3 {
    $path = getenv('CHATTER_DB') ?: (getenv('HOME') . '/.chatter/chatter.db');
    @mkdir(dirname($path), 0755, true);
    $db = new SQLite3($path);
    $db->busyTimeout(2000);
    $db->exec('PRAGMA journal_mode=WAL');
    $db->exec('CREATE TABLE IF NOT EXISTS messages (
        id         INTEGER PRIMARY KEY,
        author     TEXT NOT NULL,
        session    TEXT NOT NULL DEFAULT \'\',
        reply_to   INTEGER,
        topic      TEXT,
        repo       TEXT,
        kind       TEXT NOT NULL DEFAULT \'chat\',
        body       TEXT NOT NULL,
        created_at TEXT NOT NULL DEFAULT (datetime(\'now\'))
    )');
    // migrate older dbs; each is a no-op if the column already exists
    @$db->exec("ALTER TABLE messages ADD COLUMN session TEXT NOT NULL DEFAULT ''");
    @$db->exec("ALTER TABLE messages ADD COLUMN reply_to INTEGER");
    @$db->exec("ALTER TABLE messages ADD COLUMN topic TEXT");
    @$db->exec("ALTER TABLE messages ADD COLUMN repo TEXT");
    if (@$db->exec("ALTER TABLE messages ADD COLUMN kind TEXT NOT NULL DEFAULT 'chat'")) {   // newly added: lift prefixes out of old bodies
        $res = $db->query('SELECT id, body FROM messages');
        while ($row = $res->fetchArray(SQLITE3_ASSOC)) {
            [$kind, $body] = split_kind($row['body']);
            if ($kind !== null) $db->exec(sprintf("UPDATE messages SET kind = '%s', body = '%s' WHERE id = %d", $kind, SQLite3::escapeString($body), $row['id']));
        }
    }
    $db->exec('CREATE TABLE IF NOT EXISTS cursors (name TEXT PRIMARY KEY, last_id INTEGER NOT NULL)');
    return $db;
}

// Parse argv into ['flag' => value, ...] plus positional args. An unknown flag is an error: taken as a boolean,
// a typo like `post --topc tests MSG` would silently post "tests". A bare "--" ends option parsing, so a
// message that itself starts with "--" can still be passed as an argument.
function args(array $argv, array $valued, array $bool = []): array {
    $opts = []; $pos = [];
    for ($i = 0; $i < count($argv); $i++) {
        $a = $argv[$i];
        if ($a === '-h') usage(0);
        if ($a === '--') { $pos = [...$pos, ...array_slice($argv, $i + 1)]; break; }
        if (!str_starts_with($a, '--')) { $pos[] = $a; continue; }
        $name = substr($a, 2);
        if ($name === 'help') usage(0);
        if (in_array($name, $valued, true)) {
            if (!isset($argv[$i + 1])) usage();
            $opts[$name] = $argv[++$i];
        } elseif (in_array($name, $bool, true)) {
            $opts[$name] = true;
        } else {
            fwrite(STDERR, "chatter: unknown option --$name (see chatter --help)\n"); exit(1);
        }
    }
    return [$opts, $pos];
}

// The repo this shell is in: the main checkout's directory name, so every worktree of a repo agrees.
// CHATTER_REPO overrides; set it empty to be in no repo. Null outside git.
function repo_name(): ?string {
    if (($r = getenv('CHATTER_REPO')) !== false) return $r === '' ? null : $r;
    $common = trim((string)shell_exec('git rev-parse --path-format=absolute --git-common-dir 2>/dev/null'));
    if ($common === '') {   // git < 2.31 (Ubuntu 20.04) lacks --path-format; the plain form may be relative
        $common = trim((string)shell_exec('git rev-parse --git-common-dir 2>/dev/null'));
        if ($common !== '') $common = (string)realpath($common);
    }
    return $common === '' ? null : basename(dirname($common));
}

// SQL condition for scope. An explicit --topic/--repo is strict. Otherwise the shell's own topic
// (CHATTER_TOPIC) and repo (from git) each mean "that one plus untagged", so general messages reach everyone.
// Stage transitions (done, decision, question) cross topic boundaries within a repo: a dependent task in
// another topic needs them, and workers forget to untag them by hand. So does a post that @mentions you:
// asking a dev in another topic by name must reach it.
const CROSS_TOPIC_KINDS = "('done', 'decision', 'question')";
function scope_where(?string $topic, ?string $repo): string {
    $w = [];
    foreach (['topic' => [$topic, getenv('CHATTER_TOPIC') ?: null], 'repo' => [$repo, repo_name()]] as $col => [$explicit, $own]) {
        if ($explicit !== null) { $w[] = "$col = '" . SQLite3::escapeString($explicit) . "'"; continue; }
        if ($own === null) continue;
        $cross = '';
        if ($col === 'topic') {
            $me = SQLite3::escapeString((string)strtok(author(), '/'));   // "@john" for john/worktree-john
            $cross = ' OR kind IN ' . CROSS_TOPIC_KINDS . " OR instr(body, '@$me') > 0";
        }
        $w[] = "($col = '" . SQLite3::escapeString($own) . "' OR $col IS NULL$cross)";
    }
    return $w ? implode(' AND ', $w) : '1';
}

// "status: running tests" -> ['status', 'running tests']; anything else -> [null, body]. URLs don't match (no space after the colon).
function split_kind(string $body): array {
    return preg_match('/^([a-z][a-z0-9-]*):\s+(.+)$/s', $body, $m) ? [$m[1], $m[2]] : [null, $body];
}

function post(array $argv): void {
    [$opts, $pos] = args($argv, ['as', 'reply-to', 'topic', 'kind']);
    $author = $opts['as'] ?? author();
    if (!isset($pos[0]) && stream_isatty(STDIN)) usage();
    $body = trim($pos[0] ?? stream_get_contents(STDIN));
    if ($body === '') { fwrite(STDERR, "chatter: empty message (see chatter --help)\n"); exit(2); }
    if (isset($opts['kind'])) { $kind = $opts['kind']; } else { [$kind, $body] = split_kind($body); $kind ??= 'chat'; }
    if (!preg_match('/^[a-z][a-z0-9-]*$/', $kind)) { fwrite(STDERR, "chatter: kind must be a lowercase word, got '$kind'\n"); exit(1); }

    $topic = ($opts['topic'] ?? getenv('CHATTER_TOPIC')) ?: null;   // --topic '' posts untagged even when CHATTER_TOPIC is set
    $repo = repo_name();
    $db = db();
    if (isset($opts['reply-to'])) {
        if (!preg_match('/^[0-9]+$/', $opts['reply-to']) || !$db->querySingle('SELECT 1 FROM messages WHERE id = ' . (int)$opts['reply-to'])) {
            fwrite(STDERR, "chatter: --reply-to must be the id of an existing message, got '{$opts['reply-to']}'\n"); exit(1);
        }
    }
    $st = $db->prepare('INSERT INTO messages (author, session, reply_to, topic, repo, kind, body) VALUES (:a, :s, :r, :t, :p, :k, :b)');
    $st->bindValue(':k', $kind);
    $st->bindValue(':t', $topic, $topic === null ? SQLITE3_NULL : SQLITE3_TEXT);
    $st->bindValue(':p', $repo, $repo === null ? SQLITE3_NULL : SQLITE3_TEXT);
    $st->bindValue(':a', $author);
    $st->bindValue(':s', substr((string)getenv('CLAUDE_CODE_SESSION_ID'), 0, 8));
    $st->bindValue(':r', isset($opts['reply-to']) ? (int)$opts['reply-to'] : null, isset($opts['reply-to']) ? SQLITE3_INTEGER : SQLITE3_NULL);
    $st->bindValue(':b', $body);
    $st->execute();
}

function read(array $argv): void {
    [$opts] = args($argv, ['since', 'last', 'from', 'grep', 'topic', 'repo', 'kind'], ['unread', 'json']);
    $db = db();
    $where = [scope_where($opts['topic'] ?? null, $opts['repo'] ?? null)];
    if (isset($opts['kind']))  $where[] = "kind = '" . SQLite3::escapeString($opts['kind']) . "'";
    if (isset($opts['since'])) $where[] = 'id > ' . (int)$opts['since'];
    if (isset($opts['unread'])) {
        // author alone isn't unique across repos (e.g. every boss posts as 'boss'); qualify by repo too
        $me = SQLite3::escapeString(author() . '@' . (repo_name() ?? '_none'));
        $hadCursor = $db->querySingle("SELECT 1 FROM cursors WHERE name = '$me'") !== null;
        $where[] = 'id > ' . (int)$db->querySingle("SELECT COALESCE(last_id, 0) FROM cursors WHERE name = '$me'");
        $db->exec("INSERT OR REPLACE INTO cursors (name, last_id) VALUES ('$me', (SELECT COALESCE(MAX(id), 0) FROM messages))");
        // no cursor yet (first --unread ever, or its key just changed): don't dump the whole thread, match
        // the SessionStart hook's "chatter read --last 30"
        if (!$hadCursor && !isset($opts['last'])) $opts['last'] = 30;
    }
    // instr, not LIKE: a % or _ in the text is literal ("--grep 0%" must not match "1000")
    if (isset($opts['from']))  $where[] = "instr(author, '" . SQLite3::escapeString($opts['from']) . "') = 1";
    if (isset($opts['grep']))  $where[] = "instr(lower(body), lower('" . SQLite3::escapeString($opts['grep']) . "')) > 0";
    $sql = 'SELECT * FROM messages WHERE ' . implode(' AND ', $where);
    if (isset($opts['last'])) {
        // newest N, then flip back to chronological order
        $sql = "SELECT * FROM ($sql ORDER BY id DESC LIMIT " . (int)$opts['last'] . ') ORDER BY id';
    } else {
        $sql .= ' ORDER BY id';
    }

    print_rows($db->query($sql), isset($opts['json']));
}

// Print rows; returns the last id seen (0 if none). Colour only when stdout is a terminal.
function print_rows(SQLite3Result $res, bool $json): int {
    static $tty = null; $tty ??= stream_isatty(STDOUT) && !getenv('NO_COLOR');
    $c = fn(string $code, string $s) => $tty ? "\e[{$code}m{$s}\e[0m" : $s;
    $last = 0;
    while ($row = $res->fetchArray(SQLITE3_ASSOC)) {
        $last = $row['id'];
        if ($json) { echo json_encode($row, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . "\n"; continue; }
        $who = $row['author'] . ($row['session'] !== '' ? '@' . $row['session'] : '');
        static $hues = [31, 32, 33, 34, 35, 36, 91, 92, 93, 94, 95, 96]; // normal + bright ANSI, red..cyan twice over
        $hue = $hues[crc32($row['author']) % count($hues)]; // stable colour per author; 12 buckets so two authors rarely collide
        printf("%s%s  %s  %s: %s\n",
            $c('1', '#' . $row['id']),
            ($row['repo'] !== null ? $c('2', ' [' . $row['repo'] . ']') : '') . ($row['topic'] !== null ? $c('2', ' [' . $row['topic'] . ']') : '') . ($row['reply_to'] ? $c('2', ' (re #' . $row['reply_to'] . ')') : ''),
            $c('2', (new DateTime($row['created_at'], new DateTimeZone('UTC')))->setTimezone(localtz())->format('Y-m-d H:i')),
            $c('2', $row['kind']) . '  ' . $c("1;$hue", $who),
            $tty ? str_replace("\n", "\n    ", $row['body']) : $row['body']);
    }
    return $last;
}

// For a Claude Code PostToolUse hook. Cursor is per session so each session sees each message once;
// first call just sets the cursor (SessionStart already showed recent history) and prints nothing.
function notify(): void {
    $sess = substr((string)getenv('CLAUDE_CODE_SESSION_ID'), 0, 8);
    if ($sess === '') return;
    $db = db();
    $key = SQLite3::escapeString('notify:' . $sess);
    $max = (int)$db->querySingle('SELECT COALESCE(MAX(id), 0) FROM messages');
    $cur = $db->querySingle("SELECT last_id FROM cursors WHERE name = '$key'");
    $db->exec("INSERT OR REPLACE INTO cursors (name, last_id) VALUES ('$key', $max)");
    if ($cur === null || $cur === false) return;
    $res = $db->query("SELECT * FROM messages WHERE id > $cur AND session != '" . SQLite3::escapeString($sess) . "' AND " . scope_where(null, null) . " ORDER BY id");
    $lines = [];
    while ($row = $res->fetchArray(SQLITE3_ASSOC)) {
        $lines[] = sprintf('#%d%s%s%s %s %s: %s', $row['id'], $row['repo'] !== null ? " [{$row['repo']}]" : '', $row['topic'] !== null ? " [{$row['topic']}]" : '', $row['reply_to'] ? " (re #{$row['reply_to']})" : '', $row['kind'], $row['author'], $row['body']);
    }
    if (!$lines) return;
    echo json_encode(['hookSpecificOutput' => [
        'hookEventName' => 'PostToolUse',
        'additionalContext' => "New chatter messages from other sessions (reply with chatter post --reply-to ID if they need you):\n" . implode("\n", $lines),
    ]], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES), "\n";
}

function tail(array $argv): void {
    [$opts] = args($argv, ['last', 'topic', 'repo', 'kind'], ['once', 'json']);
    $db = db();
    $ppid = function_exists('posix_getppid') ? posix_getppid() : null;
    $n = (int)($opts['last'] ?? 20);
    $w = scope_where($opts['topic'] ?? null, $opts['repo'] ?? null);
    if (isset($opts['kind'])) $w .= " AND kind = '" . SQLite3::escapeString($opts['kind']) . "'";
    $since = (int)$db->querySingle('SELECT COALESCE(MAX(id), 0) FROM messages');
    print_rows($db->query("SELECT * FROM (SELECT * FROM messages WHERE $w ORDER BY id DESC LIMIT $n) ORDER BY id"), isset($opts['json']));
    while (true) { // ponytail: 2s poll; good enough for humans and agents, no server needed. Exits on --once or orphaning
        sleep(2);
        if ($ppid !== null && posix_getppid() !== $ppid) exit;   // orphaned: whoever read us is gone, and a quiet scope never hits a broken pipe
        $last = print_rows($db->query("SELECT * FROM messages WHERE id > $since AND $w ORDER BY id"), isset($opts['json']));
        if ($last && isset($opts['once'])) exit;
        $since = max($since, $last);
    }
}

// --repo alone, machine-stable, for scripts (e.g. chatter-agent); otherwise the human-readable block.
function whoami(array $argv): void {
    [$opts] = args($argv, [], ['repo']);
    if (isset($opts['repo'])) { echo (repo_name() ?? '') . "\n"; return; }
    printf("author: %s\nrepo:   %s\ntopic:  %s\n", author(), repo_name() ?? '(none, seen by everyone)', (getenv('CHATTER_TOPIC') ?: null) ?? '(none, seen by everyone)');
}

match ($argv[1] ?? null) {
    'post' => post(array_slice($argv, 2)),
    'read' => read(array_slice($argv, 2)),
    'tail' => tail(array_slice($argv, 2)),
    'notify' => notify(),
    'whoami' => whoami(array_slice($argv, 2)),
    'help', '-h', '--help' => usage(0),
    default => usage(),
};
