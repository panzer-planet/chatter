#!/usr/bin/env php
<?php
// chatter: a single global chat thread, stored in a local SQLite file.

function usage(int $code = 1): never {
    fwrite($code === 0 ? STDOUT : STDERR, <<<TXT
usage: chatter post [--as NAME] [--reply-to ID] [MESSAGE]   (reads stdin if MESSAGE omitted)
       chatter read [--since ID] [--unread] [--last N] [--from NAME] [--grep TEXT] [--json]
                    (--unread: only messages since your last --unread call; cursor is per author name)
       chatter tail [--last N] [--json]                         (follow the thread; Ctrl-C to stop)
       chatter notify        (Claude Code PostToolUse hook: emits unread messages from other sessions as context)

env:   CHATTER_DB   path to database  (default ~/.chatter/chatter.db)
       CHATTER_USER default author    (default \$USER)

TXT);
    exit($code);
}

// PHP defaults to UTC; use $TZ or the system zone (macOS and Linux both symlink /etc/localtime into a zoneinfo dir).
function localtz(): DateTimeZone {
    $tz = getenv('TZ') ?: preg_replace('#.*/zoneinfo/#', '', (string)@readlink('/etc/localtime'));
    try { return new DateTimeZone($tz ?: 'UTC'); } catch (Exception) { return new DateTimeZone('UTC'); }
}

// Default author: --as, then $CHATTER_USER, then <repo>/<branch> if inside a git checkout, then $USER.
function author(): string {
    if ($u = getenv('CHATTER_USER')) return $u;
    $top = trim((string)shell_exec('git rev-parse --show-toplevel 2>/dev/null'));
    $branch = trim((string)shell_exec('git branch --show-current 2>/dev/null'));
    if ($top !== '' && $branch !== '') return basename($top) . '/' . $branch;
    return getenv('USER') ?: 'anon';
}

function db(): SQLite3 {
    $path = getenv('CHATTER_DB') ?: (getenv('HOME') . '/.chatter/chatter.db');
    @mkdir(dirname($path), 0755, true);
    $db = new SQLite3($path);
    $db->busyTimeout(2000);
    $db->exec('PRAGMA journal_mode=WAL');
    $db->exec('CREATE TABLE IF NOT EXISTS messages (
        id         INTEGER PRIMARY KEY,
        author     TEXT NOT NULL,
        session    TEXT NOT NULL DEFAULT \'\',
        reply_to   INTEGER,
        body       TEXT NOT NULL,
        created_at TEXT NOT NULL DEFAULT (datetime(\'now\'))
    )');
    // migrate older dbs; each is a no-op if the column already exists
    @$db->exec("ALTER TABLE messages ADD COLUMN session TEXT NOT NULL DEFAULT ''");
    @$db->exec("ALTER TABLE messages ADD COLUMN reply_to INTEGER");
    $db->exec('CREATE TABLE IF NOT EXISTS cursors (name TEXT PRIMARY KEY, last_id INTEGER NOT NULL)');
    return $db;
}

// Parse argv into ['flag' => value, ...] plus positional args.
function args(array $argv, array $valued): array {
    $opts = []; $pos = [];
    for ($i = 0; $i < count($argv); $i++) {
        $a = $argv[$i];
        if ($a === '-h') usage(0);
        if (!str_starts_with($a, '--')) { $pos[] = $a; continue; }
        $name = substr($a, 2);
        if ($name === 'help') usage(0);
        if (in_array($name, $valued, true)) {
            if (!isset($argv[$i + 1])) usage();
            $opts[$name] = $argv[++$i];
        } else {
            $opts[$name] = true;
        }
    }
    return [$opts, $pos];
}

function post(array $argv): void {
    [$opts, $pos] = args($argv, ['as', 'reply-to']);
    $author = $opts['as'] ?? author();
    if (!isset($pos[0]) && stream_isatty(STDIN)) usage();
    $body = trim($pos[0] ?? stream_get_contents(STDIN));
    if ($body === '') { fwrite(STDERR, "chatter: empty message (see chatter --help)\n"); exit(2); }

    $st = db()->prepare('INSERT INTO messages (author, session, reply_to, body) VALUES (:a, :s, :r, :b)');
    $st->bindValue(':a', $author);
    $st->bindValue(':s', substr((string)getenv('CLAUDE_CODE_SESSION_ID'), 0, 8));
    $st->bindValue(':r', isset($opts['reply-to']) ? (int)$opts['reply-to'] : null, isset($opts['reply-to']) ? SQLITE3_INTEGER : SQLITE3_NULL);
    $st->bindValue(':b', $body);
    $st->execute();
}

function read(array $argv): void {
    [$opts] = args($argv, ['since', 'last', 'from', 'grep']);
    $db = db();
    $where = ['1'];
    if (isset($opts['since'])) $where[] = 'id > ' . (int)$opts['since'];
    if (isset($opts['unread'])) {
        $me = SQLite3::escapeString(author());
        $where[] = 'id > ' . (int)$db->querySingle("SELECT COALESCE(last_id, 0) FROM cursors WHERE name = '$me'");
        $db->exec("INSERT OR REPLACE INTO cursors (name, last_id) VALUES ('$me', (SELECT COALESCE(MAX(id), 0) FROM messages))");
    }
    if (isset($opts['from']))  $where[] = "author LIKE '" . SQLite3::escapeString($opts['from']) . "%'";
    if (isset($opts['grep']))  $where[] = "body LIKE '%" . SQLite3::escapeString($opts['grep']) . "%'";
    $sql = 'SELECT * FROM messages WHERE ' . implode(' AND ', $where);
    if (isset($opts['last'])) {
        // newest N, then flip back to chronological order
        $sql = "SELECT * FROM ($sql ORDER BY id DESC LIMIT " . (int)$opts['last'] . ') ORDER BY id';
    } else {
        $sql .= ' ORDER BY id';
    }

    print_rows($db->query($sql), isset($opts['json']));
}

// Print rows; returns the last id seen (0 if none). Colour only when stdout is a terminal.
function print_rows(SQLite3Result $res, bool $json): int {
    static $tty = null; $tty ??= stream_isatty(STDOUT) && !getenv('NO_COLOR');
    $c = fn(string $code, string $s) => $tty ? "\e[{$code}m{$s}\e[0m" : $s;
    $last = 0;
    while ($row = $res->fetchArray(SQLITE3_ASSOC)) {
        $last = $row['id'];
        if ($json) { echo json_encode($row, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . "\n"; continue; }
        $who = $row['author'] . ($row['session'] !== '' ? '@' . $row['session'] : '');
        $hue = 31 + crc32($row['author']) % 6; // stable colour per author: red..cyan
        printf("%s%s  %s  %s: %s\n",
            $c('1', '#' . $row['id']),
            $row['reply_to'] ? $c('2', ' (re #' . $row['reply_to'] . ')') : '',
            $c('2', (new DateTime($row['created_at'], new DateTimeZone('UTC')))->setTimezone(localtz())->format('Y-m-d H:i')),
            $c("1;$hue", $who),
            $tty ? str_replace("\n", "\n    ", $row['body']) : $row['body']);
    }
    return $last;
}

// For a Claude Code PostToolUse hook. Cursor is per session so each session sees each message once;
// first call just sets the cursor (SessionStart already showed recent history) and prints nothing.
function notify(): void {
    $sess = substr((string)getenv('CLAUDE_CODE_SESSION_ID'), 0, 8);
    if ($sess === '') return;
    $db = db();
    $key = SQLite3::escapeString('notify:' . $sess);
    $max = (int)$db->querySingle('SELECT COALESCE(MAX(id), 0) FROM messages');
    $cur = $db->querySingle("SELECT last_id FROM cursors WHERE name = '$key'");
    $db->exec("INSERT OR REPLACE INTO cursors (name, last_id) VALUES ('$key', $max)");
    if ($cur === null || $cur === false) return;
    $res = $db->query("SELECT * FROM messages WHERE id > $cur AND session != '" . SQLite3::escapeString($sess) . "' ORDER BY id");
    $lines = [];
    while ($row = $res->fetchArray(SQLITE3_ASSOC)) {
        $lines[] = sprintf('#%d%s %s: %s', $row['id'], $row['reply_to'] ? " (re #{$row['reply_to']})" : '', $row['author'], $row['body']);
    }
    if (!$lines) return;
    echo json_encode(['hookSpecificOutput' => [
        'hookEventName' => 'PostToolUse',
        'additionalContext' => "New chatter messages from other sessions (reply with chatter post --reply-to ID if they need you):\n" . implode("\n", $lines),
    ]], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES), "\n";
}

function tail(array $argv): void {
    [$opts] = args($argv, ['last']);
    $db = db();
    $n = (int)($opts['last'] ?? 20);
    $since = (int)$db->querySingle('SELECT COALESCE(MAX(id), 0) FROM messages');
    print_rows($db->query("SELECT * FROM (SELECT * FROM messages ORDER BY id DESC LIMIT $n) ORDER BY id"), isset($opts['json']));
    while (true) { // ponytail: 2s poll; good enough for humans and agents, no server needed
        sleep(2);
        $since = max($since, print_rows($db->query("SELECT * FROM messages WHERE id > $since ORDER BY id"), isset($opts['json'])));
    }
}

match ($argv[1] ?? null) {
    'post' => post(array_slice($argv, 2)),
    'read' => read(array_slice($argv, 2)),
    'tail' => tail(array_slice($argv, 2)),
    'notify' => notify(),
    'help', '-h', '--help' => usage(0),
    default => usage(),
};
